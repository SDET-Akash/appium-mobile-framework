<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Master TestNG suite. <test> entries referencing actual test classes
    will be added here as they are implemented.
-->
<suite name="Mobile Automation Suite" verbose="1">

    <listeners>
        <listener class-name="com.automation.mobile.listeners.TestListener"/>
    </listeners>


    <test name="Driver Smoke Test">
        <classes>
            <class name="com.automation.mobile.tests.android.DriverSmokeTest"/>
            <class name="com.automation.mobile.tests.android.LoginTest"/>
            <class name="com.automation.mobile.tests.android.DashboardTest"/>
        </classes>
    </test>

</suite>
